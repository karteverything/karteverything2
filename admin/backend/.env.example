SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New Supabase server-side secret key
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Used only if your project still uses the legacy HS256 JWT signing secret.
# Leave blank if your project uses asymmetric signing/JWKS.
SUPABASE_JWT_SECRET=

# Your frontend
FRONTEND_URL=http://localhost:3000

# One or more Supabase auth user UUIDs allowed to administer the gallery.
ADMIN_USER_IDS=YOUR_SUPABASE_USER_UUID

MAX_UPLOAD_SIZE_MB=15